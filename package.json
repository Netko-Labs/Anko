{
  "name": "anko",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/desktop/*",
    "packages/shared/*"
  ],
  "scripts": {
    "start": "turbo run copy:sidecar && bun run --cwd apps/desktop dev",
    "dev": "bun run start",
    "build": "turbo run check-types build build:binary",
    "typecheck": "turbo run check-types",
    "check-types": "turbo run check-types",
    "build:mcp-bridge": "turbo run build:binary --filter=@anko/mcp-bridge",
    "build:app": "turbo run copy:sidecar && bun run --cwd apps/desktop build:app",
    "release": "turbo run copy:sidecar && bun run --cwd apps/desktop release",
    "clean": "rm -rf build dist .turbo .mirin .cache apps/desktop/build apps/desktop/dist apps/desktop/.mirin apps/mcp-bridge/dist node_modules apps/*/node_modules packages/*/*/node_modules",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "bun test",
    "db:generate": "bun run --cwd packages/desktop/repository db:generate",
    "db:migrate": "bun run --cwd packages/desktop/repository db:migrate",
    "prepare": "husky"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@mirinjs/cli": "0.1.0-alpha.22",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "husky": "^9.1.7",
    "turbo": "^2.10.4",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@mirinjs/darwin-arm64": "0.1.0-alpha.22",
    "@mirinjs/linux-arm64": "0.1.0-alpha.22",
    "@mirinjs/linux-x64": "0.1.0-alpha.22",
    "@mirinjs/win32-arm64": "0.1.0-alpha.22",
    "@mirinjs/win32-x64": "0.1.0-alpha.22"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@hono/node-server": "1.19.14",
    "brace-expansion": "5.0.7",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.3",
    "hono": "4.12.28",
    "ip-address": "10.2.0",
    "js-yaml": "4.3.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "postcss": "8.5.16",
    "qs": "6.15.3"
  }
}
