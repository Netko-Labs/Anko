{
  "name": "anko",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "start": "bun run build:mcp-bridge && mirin dev",
    "dev": "bun run start",
    "build": "tsgo -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsgo -p tsconfig.app.json --noEmit",
    "build:mcp-bridge": "bun build src/mcp-bridge/index.ts --compile --outfile build/sidecars/anko-mcp",
    "build:app": "bun run build:mcp-bridge && mirin build",
    "release": "bun run build:mcp-bridge && mirin release",
    "clean": "rm -rf build dist .cache node_modules",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "bun test",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.11",
    "lucide-react": "^0.562.0",
    "mirinjs": "0.1.0-alpha.18",
    "next-themes": "^0.4.6",
    "node-sql-parser": "^5.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1",
    "react-shiki": "^0.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@mirinjs/cli": "0.1.0-alpha.18",
    "@types/bun": "latest",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "shadcn": "^4.13.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@hono/node-server": "1.19.14",
    "brace-expansion": "5.0.7",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.3",
    "hono": "4.12.28",
    "ip-address": "10.2.0",
    "js-yaml": "4.3.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "postcss": "8.5.16",
    "qs": "6.15.3"
  }
}
